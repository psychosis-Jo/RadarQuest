{
  "github": {
    "label": "GitHub",
    "enabled": true,
    "type": "api",
    "config": {
      "endpoint": "https://api.github.com/search/repositories",
      "query": "stars:>100 created:>2025-01-01",
      "sort": "stars",
      "per_page": 30
    },
    "fetch_interval": "daily"
  },
  "producthunt": {
    "label": "Product Hunt",
    "enabled": true,
    "type": "api",
    "config": {
      "endpoint": "https://api.producthunt.com/v2/api/graphql",
      "query_type": "today"
    },
    "fetch_interval": "daily"
  },
  "hackernews": {
    "label": "Hacker News",
    "enabled": true,
    "type": "api",
    "config": {
      "endpoint": "https://hacker-news.firebaseio.com/v0",
      "min_score": 100,
      "max_items": 30
    },
    "fetch_interval": "daily"
  },
  "reddit": {
    "label": "Reddit",
    "enabled": true,
    "type": "api",
    "config": {
      "subreddits": [
        "programming",
        "MachineLearning",
        "IndieHackers",
        "productivity",
        "selfimprovement"
      ],
      "min_score": 50,
      "max_items_per_sub": 10
    },
    "fetch_interval": "daily"
  },
  "newsletter": {
    "label": "Newsletter",
    "enabled": true,
    "type": "rss",
    "config": {
      "feeds": []
    },
    "fetch_interval": "daily"
  },
  "wechat": {
    "label": "公众号",
    "enabled": true,
    "type": "rss_via_rsshub",
    "config": {
      "rsshub_base_url": "https://rsshub.app",
      "accounts": []
    },
    "fetch_interval": "daily"
  }
}
